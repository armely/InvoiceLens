# Copy this file to `.env` at the repo root for shared defaults.
# Then add environment-specific overrides in `.env.local`, `.env.test`, or `.env.prod`.
# The API, worker, web scripts, and deployment scripts load `.env` first and then the override file.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
APP_BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:5106

# Optional Azure infrastructure deployment overrides (used by infra/bicep/scripts/*.ps1)
# These values let you control naming and target regions without editing bicepparam files.
INVOICELENS_INFRA_RESOURCE_PREFIX=invoicelens
INVOICELENS_INFRA_DEV_DEPLOYMENT_NAME=invoicelens-dev-infra
INVOICELENS_INFRA_TEST_DEPLOYMENT_NAME=invoicelens-test-infra
INVOICELENS_INFRA_PROD_DEPLOYMENT_NAME=invoicelens-prod-infra
INVOICELENS_INFRA_DEV_LOCATION=eastus
INVOICELENS_INFRA_TEST_LOCATION=eastus2
INVOICELENS_INFRA_PROD_LOCATION=centralus
INVOICELENS_INFRA_DEV_SQL_LOCATION=eastus2
INVOICELENS_INFRA_TEST_SQL_LOCATION=eastus2
INVOICELENS_INFRA_PROD_SQL_LOCATION=centralus
INVOICELENS_INFRA_DEV_APP_SERVICE_PLAN_SKU_NAME=B1
INVOICELENS_INFRA_DEV_APP_SERVICE_PLAN_SKU_TIER=Basic
INVOICELENS_INFRA_DEV_APP_SERVICE_PLAN_SKU_CAPACITY=1
INVOICELENS_INFRA_DEV_DEPLOY_APP_SERVICE_WEB_API=true
INVOICELENS_INFRA_DEV_DEPLOY_CONTAINER_APP_WEB_API=false
INVOICELENS_INFRA_DEV_DEPLOY_WORKER_JOB=false
INVOICELENS_INFRA_DEV_DEPLOY_OPENINVOICE_MOCK=true

# Optional app image deployment values (used by infra/bicep/scripts/deploy-app-dev.ps1)
INVOICELENS_INFRA_ENVIRONMENT=dev
INVOICELENS_API_IMAGE=invoicelens-api:dev
INVOICELENS_WEB_IMAGE=invoicelens-web:dev
INVOICELENS_OPENINVOICEMOCK_IMAGE=invoicelens-openinvoicemock:dev
INVOICELENS_WORKER_IMAGE=invoicelens-worker:dev

# Optional secure overrides for infra deployment parameters
INVOICELENS_INFRA_SQL_ADMIN_LOGIN=
INVOICELENS_INFRA_SQL_ADMIN_PASSWORD=

# SQL Server connection options. Use exactly one of the examples below.

# Local SQL Server or Docker SQL Server
InvoiceLens__Sql__ServerHost=localhost,1433
InvoiceLens__Sql__DatabaseName=InvoiceLens
InvoiceLens__Sql__Username=sa
InvoiceLens__Sql__Password=Your_password123
InvoiceLens__Sql__Encrypt=False
InvoiceLens__Sql__TrustServerCertificate=True

# SQL Server Express
# InvoiceLens__Sql__ServerHost=localhost\SQLEXPRESS
# InvoiceLens__Sql__DatabaseName=InvoiceLens
# InvoiceLens__Sql__Username=sa
# InvoiceLens__Sql__Password=Your_password123
# InvoiceLens__Sql__Encrypt=False
# InvoiceLens__Sql__TrustServerCertificate=True

# Azure SQL
# InvoiceLens__Sql__ServerHost=your-server.database.windows.net
# InvoiceLens__Sql__DatabaseName=InvoiceLens
# InvoiceLens__Sql__Username=your-admin-user
# InvoiceLens__Sql__Password=your-strong-password
# InvoiceLens__Sql__Encrypt=True
# InvoiceLens__Sql__TrustServerCertificate=False

# Optional app-level settings
InvoiceLens__Sql__Provider=SqlServer
InvoiceLens__Sql__CommandTimeoutSeconds=30
InvoiceLens__LocalInvoices__Enabled=true
InvoiceLens__LocalInvoices__PdfFolder=samples/invoices/pdf
InvoiceLens__LocalInvoices__MetadataFolder=samples/invoices/metadata
InvoiceLens__LocalInvoices__AutoCompareOnStartup=false
InvoiceLens__Comparison__AmountTolerance=0.01
InvoiceLens__Comparison__DateToleranceDays=0
InvoiceLens__Comparison__RequireSupplierNumber=true
SyncSchedule__IncrementalSyncMinutes=60
SyncSchedule__ReconciliationMinutes=240
SyncSchedule__RetryMinutes=30

# OpenInvoice switch-over settings
OpenInvoice__Environment=Mock
OpenInvoice__BaseUrl=http://localhost:5189
OpenInvoice__UseMock=true
OpenInvoice__EnableHmac=true
OpenInvoice__HmacSigningKey=local-test-hmac-key
OpenInvoice__MacHeaderName=mac
OpenInvoice__CertificateEnabled=false
OpenInvoice__CertificatePath=
OpenInvoice__CertificatePassword=
OpenInvoice__EnableAllowedIpSimulation=false
OpenInvoice__AllowedIps=127.0.0.1,::1
OpenInvoice__CompanyId=LOCAL-COMPANY
OpenInvoice__BuyerDuns=000000000
OpenInvoice__TimeoutSeconds=660
OpenInvoice__DefaultPageSize=100
OpenInvoice__MaxRetryCount=3
OpenInvoice__RetryDelaySeconds=10

# Optional OpenInvoiceMock host binding (used by local launch profiles or containers)
OpenInvoiceMock__BaseUrl=http://localhost:5189

# Microsoft sign-in for the frontend
InvoiceLens__Auth__ClientId=
InvoiceLens__Auth__TenantId=
InvoiceLens__Auth__RedirectUri=http://localhost:4200/
InvoiceLens__Auth__PostLogoutRedirectUri=http://localhost:4200/
InvoiceLens__Auth__Scopes=openid profile email User.Read

# Optional monitoring settings for cloud-hosted environments
ApplicationInsights__ConnectionString=
Logging__LogLevel__Default=Information
